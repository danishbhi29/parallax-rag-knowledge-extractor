# Parallax RAG Project Specific Rules
# ==============================================================================

# Custom Virtual Environment folder name
v/

# Data directories (Raw and Processed)
/data/

# Vector Database (ChromaDB persistent storage)
chroma_db/

# Temporary execution files
tempCodeRunnerFile.py